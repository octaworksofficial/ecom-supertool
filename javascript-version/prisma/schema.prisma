generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id                  String                @id
  companyName         String
  contactName         String?
  email               String?               @unique
  phone               String?
  address             String?
  city                String?
  country             String?
  website             String?
  rating              Float?
  reviewCount         Int?
  categories          String?
  keywords            String?
  isOpen              Boolean?
  coordinates         String?
  priceLevel          Int?
  openingHours        String?
  source              String                @default("MANUAL")
  status              String                @default("ACTIVE")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  notes               String?
  CustomerInteraction CustomerInteraction[]
  CustomerTag         CustomerTag[]
}

model CustomerInteraction {
  id          String   @id
  customerId  String
  type        String
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  Customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTag {
  id        String     @id
  name      String     @unique
  color     String?
  createdAt DateTime   @default(now())
  Customer  Customer[]
}
