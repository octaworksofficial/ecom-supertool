generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String                @id @default(cuid())
  companyName  String
  contactName  String?
  email        String?               @unique
  phone        String?
  address      String?
  city         String?
  country      String?
  website      String?
  source       String                @default("MANUAL")
  status       String                @default("ACTIVE")
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  interactions CustomerInteraction[]
  emailSends   EmailSend[]
  tags         CustomerTag[]         @relation("CustomerToCustomerTag")
}

model CustomerInteraction {
  id         String   @id @default(cuid())
  customerId String
  type       String
  subject    String
  content    String?
  date       DateTime
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String?
  createdAt DateTime   @default(now())
  customers Customer[] @relation("CustomerToCustomerTag")
}

model EmailSend {
  id            String    @id @default(cuid())
  campaignId    String
  customerId    String?
  toEmail       String
  subject       String
  content       String
  isHtml        Boolean   @default(true)
  status        String    @default("pending")
  sentAt        DateTime?
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  clickCount    Int       @default(0)
  lastClickedAt DateTime?
  errorMessage  String?
  trackingId    String?   @unique
  createdAt     DateTime  @default(now())
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  content     String
  isHtml      Boolean  @default(true)
  category    String?  @default("general")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrendyolSettings {
  id                String   @id @default(cuid())
  sellerId          String   @default("")
  apiKey            String   @default("")
  secretKey         String   @default("")
  checkInterval     Int      @default(30)
  openaiApiKey      String   @default("")
  openaiModel       String   @default("gpt-4o")
  openaiMaxTokens   Int      @default(1000)
  openaiTemperature Float    @default(0.7)
  assistantId       String   @default("")
  answerTemplate    String   @default("{answer}")
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BotActivity {
  id          String   @id @default(cuid())
  status      String   // "checking_questions", "found_question", "getting_ai_response", "sending_answer", "waiting", "idle"
  message     String
  questionId  String?
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model BotStatus {
  id              String   @id @default(cuid())
  isRunning       Boolean  @default(false)
  currentStatus   String   @default("idle") // Botun şu anki durumu
  currentMessage  String   @default("Bot durdu")
  startedAt       DateTime?
  lastCheck       DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}
